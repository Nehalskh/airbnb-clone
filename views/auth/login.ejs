<%- include('../partials/head') %>
<body>
  <%- include('../partials/nav',{pageTitle: pageTitle, isLoggedIn: isLoggedIn}) %>
  <main class="container mx-auto mt-8 pt-8 bg-white rounded-lg shadow-md">
    <h1 class="text-3xl font-bold mb-6 text-center text-gray-800">
      Login with your Credentials
    </h1>
    <form action="/login" method="POST" class="max-w-md mx-auto">
      <input type="hidden" name="_id" value="<%=editing ? home._id : '' %>" />
      <input
        type="text"
        name="username"
        placeholder="Enter your username"
        class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"
        required
      />
      <input
        type="password"
        name="password"
        step="0.01"
        placeholder="Enter your password"
        class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"
        required
      />
      <input
        type="submit"
        class="w-full bg-red-500 text-white py-2 rounded-md hover:bg-red-600 transition duration-300"
        value="Sign in"
      />
    </form>
  </main>
</body>
<%- include("../partials/end") %>
