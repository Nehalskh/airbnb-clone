<%- include('../partials/head') %>
<body>
  <%- include('../partials/nav',{pageTitle: pageTitle}) %>
  <main class="container mx-auto mt-8 pt-8 bg-white rounded-lg shadow-md">
    <h1 class="text-3xl font-bold mb-6 text-center text-gray-800">
      <%= editing ? "Edit": "Register"%> Your Home on airbnb
    </h1>
    <form action="/host/<%= editing ? "edit-Home" : "add-home"%>" method="POST" class="max-w-md mx-auto">
      <input type="hidden" name="_id" value="<%=editing ? home._id : '' %>"/>
      <input
        type="text"
        name="houseName"
        value="<%=editing ? home.houseName : '' %>"
        placeholder="Enter your House Name"
        class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"
      />
      <input
       type="number"
       name="price"
       step="0.01"
       min="0"
       required
       value="<%= editing && home.price !== null ? home.price : '' %>"
       placeholder="Price per night"
       class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"
      />

      <input
        type="text"
        name="location"
        value="<%=editing ? home.location : '' %>"
        placeholder="Location of the House"
        class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"
      />
      <input
        type="text"
        name="rating"
        value="<%=editing ? home.rating : '' %>"
        placeholder="Rating of the House"
        class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"
      />
      <input
        type="text"
        name="photoUrl"
        value="<%=editing ? home.photoUrl : '' %>"
        placeholder="Enter Photo URL"
        class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"
      />
      <textarea
        name="description"
        placeholder="Describe your home"
        class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"><%=editing ? home.description : '' %></textarea>
      <input
        type="submit"
        value="<%= editing ? "Update Home" : "Add Home"%>"
        class="w-full bg-red-500 text-white py-2 rounded-md hover:bg-red-600 transition duration-300"
      />
    </form>
  </main>
</body>
<%- include("../partials/end") %>
